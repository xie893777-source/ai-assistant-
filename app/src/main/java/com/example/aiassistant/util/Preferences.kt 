package com.example.aiassistant.util

import android.content.Context
import androidx.core.content.edit

object Preferences {
    private const val PREF_NAME = "ai_settings"

    fun save(context: Context, key: String, value: String) {
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE).edit { putString(key, value) }
    }
    fun saveInt(context: Context, key: String, value: Int) {
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE).edit { putInt(key, value) }
    }

    fun get(context: Context, key: String, default: String = ""): String =
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE).getString(key, default) ?: default

    fun getInt(context: Context, key: String, default: Int = 3): Int =
        context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE).getInt(key, default)

    fun getApiKey(c: Context) = get(c, "api_key")
    fun getBaseUrl(c: Context) = get(c, "base_url", "https://api.openai.com/")
    fun getModel(c: Context) = get(c, "model", "gpt-3.5-turbo")
    fun getSystemPrompt(c: Context) = get(c, "system_prompt", "你是一个有帮助的AI助手。")
    fun getThinkLevel(c: Context) = getInt(c, "think_level", 3)
}
